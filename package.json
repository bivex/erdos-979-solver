{
  "name": "erdos-979-solver",
  "version": "1.0.0",
  "description": "High-performance solver & computational study of Erdős Problem #979 (limsup f_k(n) = infinity for sums of k k-th powers of primes)",
  "main": "dist/index.js",
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node",
    "test": "bun test",
    "start": "bun run src/index.ts",
    "verify:proof": "bun run src/formal_proof_verifier.ts",
    "verify:z3": "python3 src/z3_solver.py",
    "build:cpp": "clang++ -std=c++17 -O3 cpp/erdos979.cpp -o erdos979_cpp",
    "start:cpp": "bun run build:cpp && ./erdos979_cpp",
    "build:k3": "clang++ -std=c++17 -O3 -arch arm64 cpp/erdos979_k3_record.cpp -o erdos979_k3_record",
    "start:k3": "bun run build:k3 && ./erdos979_k3_record",
    "build:arm64": "clang++ -std=c++17 -O3 -arch arm64 cpp/erdos979_arm64.s cpp/erdos979_arm64_bench.cpp -o erdos979_arm64_bench",
    "start:arm64": "bun run build:arm64 && ./erdos979_arm64_bench",
    "build:metal": "clang++ -std=c++17 -O3 -framework Metal -framework Foundation cpp/erdos979_metal.mm -o erdos979_metal",
    "start:metal": "bun run build:metal && ./erdos979_metal",
    "build:erdos1035": "clang++ -std=c++17 -O3 cpp/erdos1035_metal.mm -o erdos1035_engine",
    "start:erdos1035": "bun run build:erdos1035 && ./erdos1035_engine"
  },
  "keywords": [
    "erdos-problem",
    "erdos-979",
    "number-theory",
    "prime-powers",
    "computational-math"
  ],
  "author": "Bivex",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.0.0"
  }
}
